{
  "name": "ai-chat-vscode",
  "description": "AI Chat",
  "version": "0.8.2",
  "publisher": "dimslaev",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimslaev/ai-chat"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.98.0"
  },
  "activationEvents": [],
  "main": "./out/extension/index.js",
  "icon": "resources/chat-icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-chat-sidebar",
          "title": "AI Chat",
          "icon": "resources/chat-icon.png"
        }
      ]
    },
    "views": {
      "ai-chat-sidebar": [
        {
          "type": "webview",
          "id": "ai-chat-view",
          "name": "AI Chat",
          "icon": "resources/chat-icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "ai-chat.generateProjectMd",
        "title": "Analyze Project & Generate project.md",
        "category": "AI Chat"
      },
      {
        "command": "ai-chat.toggleSuggestedFile",
        "title": "Toggle Suggested File in Context",
        "category": "AI Chat"
      },
      {
        "command": "ai-chat.focusInput",
        "title": "Focus Chat Input",
        "category": "AI Chat"
      },
      {
        "command": "ai-chat.changeConfig",
        "title": "Change Config",
        "category": "AI Chat"
      }
    ],
    "keybindings": [
      {
        "command": "ai-chat.toggleSuggestedFile",
        "key": "ctrl+k ctrl+k",
        "mac": "cmd+k cmd+k"
      },
      {
        "command": "ai-chat.focusInput",
        "key": "ctrl+k ctrl+i",
        "mac": "cmd+k cmd+i"
      },
      {
        "command": "ai-chat.changeConfig",
        "key": "ctrl+k ctrl+o",
        "mac": "cmd+k cmd+o"
      }
    ]
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:extension": "webpack --mode production --config-name extension",
    "build:webview": "webpack --mode production --config-name webview",
    "watch": "webpack --mode development --watch",
    "watch:extension": "webpack --mode development --watch --config-name extension",
    "watch:webview": "webpack --mode development --watch --config-name webview",
    "package": "npm run build && vsce package",
    "install:local": "code --install-extension ai-chat-vscode-$(node -p \"require('./package.json').version\").vsix",
    "release": "npm run package && git push && git push --tags",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/marked": "^4.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/vscode": "^1.98.0",
    "css-loader": "^6.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.7.4",
    "style-loader": "^3.0.0",
    "ts-loader": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "webpack": "^5.0.0",
    "webpack-cli": "^4.0.0"
  },
  "dependencies": {
    "@ai-sdk/mistral": "^3.0.1",
    "@ai-sdk/openai": "^3.0.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.2.1",
    "ai": "^6.0.3",
    "classnames": "^2.5.1",
    "highlight.js": "^11.11.1",
    "pdfreader": "^3.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-textarea-autosize": "^8.5.8",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.5"
  }
}
